# ciberseguridad.com.py — Apache (Hostinger). Set the domain document root to
# public_html/ so src/, storage/, tests/ and .env are not served at all. The
# rules below are the second line of defence, not the first.
Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# Deny private paths before canonicalization or page routing.
RewriteCond %{REQUEST_URI} !/\.well-known/
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(src|storage|tests|docs|bin|tools|vendor)(/|$) - [F,L]
RewriteCond %{THE_REQUEST} "\s/+public_html(?:[/\s?]|$)" [NC]
RewriteRule ^ - [F,L]

# HTTPS, non-www (canonical host = ciberseguridad.com.py).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://ciberseguridad.com.py%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.ciberseguridad\.com\.py$ [NC]
RewriteRule ^ https://ciberseguridad.com.py%{REQUEST_URI} [L,R=301]

# /index and /index.php -> /.
RewriteRule ^index(\.php)?$ / [L,R=301]

# /pagina.php -> /pagina (one URL per page).
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteCond %{ENV:REDIRECT_STATUS} !^[45]
RewriteRule ^(.+)\.php$ /$1/ [L,R=301,NE]

# Preserve published trailing-slash page URLs.
RewriteCond %{REQUEST_URI} !/enviar$
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+[^/])$ /$1/ [L,R=301]

# Extensionless URLs.
RewriteRule ^enviar/?$ enviar.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !\.php$ [NC]
RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>

# Never serve secrets, dotfiles (except .well-known), markdown, logs, dumps.
<IfModule mod_rewrite.c>
RewriteCond %{REQUEST_URI} !/\.well-known/
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(src|storage|tests|docs|bin|tools|vendor)(/|$) - [F,L]
</IfModule>
<FilesMatch "(?i)\.(md|env|log|csv|ini|sh|bak|sql|lock|dist|example)$">
  Require all denied
</FilesMatch>

ErrorDocument 403 /404.php
ErrorDocument 404 /404.php

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always unset X-Powered-By
  Header unset X-Powered-By
  # Long cache for versioned assets (?v=mtime is appended by asset()).
  <FilesMatch "\.(css|js|svg|woff2|png|jpg|webp|avif|pdf)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

AddType image/svg+xml .svg
AddDefaultCharset UTF-8
